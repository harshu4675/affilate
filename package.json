{
  "name": "affilate",
  "version": "1.0.0",
  "private": true,
  "description": "Affiliate product importer and product extraction tool",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev:client",
    "dev:api": "npm run dev:server",
    "test": "node test/run.mjs",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "start": "npm start -w server",
    "serve": "npm run build && npm run start",
    "test:ui": "npm run build:ui-test -w client && node test/ui/run.mjs",
    "test:all": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
